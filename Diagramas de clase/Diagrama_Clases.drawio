        <mxCell id="bitacora" value="&lt;b&gt;Bitacora&lt;/b&gt;&lt;hr&gt;- lstRegistros: List&amp;lt;string&amp;gt;&lt;hr&gt;+ registrarEvento(evento): void&lt;br&gt;+ mostrarBitacora(): void" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="460" width="220" height="100" as="geometry" />
