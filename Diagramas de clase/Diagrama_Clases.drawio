        </mxCell>

        <mxCell id="ticket" value="&lt;b&gt;Ticket&lt;/b&gt;&lt;hr&gt;- intNumero: int&lt;br&gt;- strMotivo: string&lt;br&gt;- strSintomas: string&lt;br&gt;- strTipoConsulta: string&lt;br&gt;- strPrioridad: string&lt;br&gt;- strEstado: string&lt;br&gt;- dtFechaCreacion: DateTime&lt;br&gt;- strDiagnostico: string&lt;br&gt;- strTratamiento: string&lt;br&gt;- blnEscalado: bool&lt;br&gt;- objMascota: Mascota&lt;br&gt;- objVeterinarioAsignado: Veterinario&lt;br&gt;- objBitacora: Bitacora&lt;hr&gt;+ asignar(v: Veterinario): void&lt;br&gt;+ registrarHallazgo(tipo, desc, gravedad): void&lt;br&gt;+ resolver(diagnostico, tratamiento): void&lt;br&gt;+ cerrar(): void&lt;br&gt;+ escalar(motivo, senior): void&lt;br&gt;+ mostrarResumen(): void&lt;br&gt;+ mostrarBitacora(): void" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="460" width="280" height="330" as="geometry" />
