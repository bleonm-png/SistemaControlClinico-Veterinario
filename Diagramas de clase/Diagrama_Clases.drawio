        <mxCell id="gestor" value="&lt;b&gt;GestorClinica&lt;/b&gt;&lt;hr&gt;- lstVeterinarios: List&amp;lt;Veterinario&amp;gt;&lt;br&gt;- lstClientes: List&amp;lt;Cliente&amp;gt;&lt;br&gt;- lstMascotas: List&amp;lt;Mascota&amp;gt;&lt;br&gt;- lstTickets: List&amp;lt;Ticket&amp;gt;&lt;br&gt;- objFlujo: FlujoTicket&lt;br&gt;- intSiguienteNumero: int&lt;hr&gt;+ crearTicket(...): Ticket&lt;br&gt;+ asignarTicket(numero): Ticket&lt;br&gt;+ asignarTicket(numero, idVet): Ticket&lt;br&gt;+ registrarHallazgo(...): Ticket&lt;br&gt;+ escalarTicket(numero, motivo): Ticket&lt;br&gt;+ resolverTicket(numero, diag, trat): Ticket&lt;br&gt;+ cerrarTicket(numero): Ticket&lt;br&gt;- asignarVeterinarioAutomatico(tipo): Veterinario&lt;br&gt;+ buscarTicket(numero): Ticket&lt;br&gt;+ mostrarTickets(): void&lt;br&gt;+ mostrarFlujo(): void&lt;br&gt;+ generarMetricas(): void" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="300" height="330" as="geometry" />
        </mxCell>

        <!-- Herencia: Cliente y Veterinario extienden Persona -->
        <mxCell id="rel1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=16;" edge="1" parent="1" source="cliente" target="persona">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=16;" edge="1" parent="1" source="veterinario" target="persona">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Asociacion: Mascota - Cliente (0..* : 1) -->
        <mxCell id="rel3" value="0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;startArrow=none;" edge="1" parent="1" source="mascota" target="cliente">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Asociacion: Ticket - Mascota (0..* : 1) -->
        <mxCell id="rel4" value="0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;startArrow=none;" edge="1" parent="1" source="ticket" target="mascota">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Asociacion: Ticket - Veterinario (0..* : 0..1) -->
        <mxCell id="rel5" value="0..*         0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;startArrow=none;" edge="1" parent="1" source="ticket" target="veterinario">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Composicion: Ticket compone Bitacora (1) -->
        <mxCell id="rel6" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=diamondThin;startFill=1;endArrow=none;" edge="1" parent="1" source="ticket" target="bitacora">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- GestorClinica administra Veterinario, Cliente, Mascota y Ticket (1 : 0..*) -->
        <mxCell id="rel7" value="1        0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;startArrow=none;" edge="1" parent="1" source="gestor" target="veterinario">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rel8" value="1     0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;startArrow=none;" edge="1" parent="1" source="gestor" target="cliente">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel9" value="1     0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;startArrow=none;" edge="1" parent="1" source="gestor" target="mascota">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel10" value="1     0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;startArrow=none;" edge="1" parent="1" source="gestor" target="ticket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dependencia: GestorClinica usa FlujoTicket para validar transiciones -->
        <mxCell id="rel11" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;startArrow=none;" edge="1" parent="1" source="gestor" target="flujo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
