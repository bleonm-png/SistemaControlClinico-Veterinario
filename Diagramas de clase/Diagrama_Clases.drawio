        <mxCell id="cliente" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;hr&gt;- strTelefono: string&lt;br&gt;- strDireccion: string&lt;br&gt;- lstMascotas: List&amp;lt;Mascota&amp;gt;&lt;hr&gt;+ obtenerRol(): string&lt;br&gt;+ mostrarInformacion(): void" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="260" width="240" height="120" as="geometry" />
