        <mxCell id="veterinario" value="&lt;b&gt;Veterinario&lt;/b&gt;&lt;hr&gt;- strEspecialidad: string&lt;br&gt;- intNivelExperiencia: int&lt;br&gt;- intCargaActual: int&lt;br&gt;- intCapacidadMaxima: int&lt;hr&gt;+ estaDisponible(): bool&lt;br&gt;+ puedeAtender(tipo): bool&lt;br&gt;+ aumentarCarga(): void&lt;br&gt;+ liberarCarga(): void&lt;br&gt;+ obtenerRol(): string&lt;br&gt;+ mostrarInformacion(): void" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="260" width="260" height="180" as="geometry" />
