  <diagram id="clases-clinica-vet" name="Diagrama de Clases Sistema Clinico Veterinario">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="persona" value="&lt;b&gt;&amp;laquo;abstract&amp;raquo;&lt;br&gt;Persona&lt;/b&gt;&lt;hr&gt;- strId: string&lt;br&gt;- strNombre: string&lt;br&gt;- strCorreo: string&lt;br&gt;- blnActivo: bool&lt;hr&gt;+ obtenerRol(): string {abstract}&lt;br&gt;+ mostrarInformacion(): void" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
